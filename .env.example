# Copy to .env and fill in. For local development, `npx supabase start` prints
# every value below except the OpenAI key — see README "Database and Supabase".
#
# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL is what the app connects with at runtime. If your provider has a
# connection pooler (Supabase, Neon), use the pooled URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/examos?schema=public"
# DIRECT_URL is used by `prisma migrate` only. It must be a direct (unpooled)
# connection. If you are not using a pooler, set it to the same value.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/examos?schema=public"

# ---------------------------------------------------------------------------
# Supabase (authentication + private file storage)
# ---------------------------------------------------------------------------
# Project Settings -> API. The anon key is public by design and is shipped to
# the browser; it is safe only because row-level security is enabled.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security. NEVER prefix this with NEXT_PUBLIC_
# and never import it from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=""
# Largest upload the app will accept, in MB. Defaults to 100. Lower it to match
# your Supabase plan's storage limit — accepting a file that storage then
# rejects makes the student wait through the whole upload to be told no.
# NEXT_PUBLIC_MAX_UPLOAD_MB="50"

# ---------------------------------------------------------------------------
# OpenAI (topic extraction, question generation, study-plan rationales)
# ---------------------------------------------------------------------------
# Server-only. Never exposed to the browser.
OPENAI_API_KEY=""
# Override to move to a different model without code changes. Copy the exact
# model ID from platform.openai.com/docs/models — the display name on the
# pricing page ("GPT-5.6 Luna") is not always the API ID.
OPENAI_MODEL="gpt-5.6-luna"
# Optional. Point at Azure OpenAI or another OpenAI-compatible gateway.
# OPENAI_BASE_URL=""
